# Source only: never commit game data, credentials or generated build products.
/vendor/
/build/
/artifacts/
/packages/
/installers/
/.venv/
/.cache/
__pycache__/
*.py[cod]
*.o
*.a
*.so
*.so.*
*.gch
*.deb
*.zip
*.tar
*.tar.gz
*.iso
*.exe
*.dll
*.bik
*.fsb
*.trb
*.sav
*.save
*.log
.env
.env.*
!.env.example
*.pem
*.key
credentials*
# Curated reports are tracked; newly generated reports stay local.
/reports/*
!/reports/build-summary.json
!/reports/window-icon-properties.txt
!/reports/patch-replay.txt
!/reports/user-file-preservation.txt
