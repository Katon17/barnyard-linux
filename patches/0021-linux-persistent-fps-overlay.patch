+
+#ifdef TOSHI_SKU_LINUX
+void AGUI2::SetNativeFPSVisible(TBOOL visible) {
+    m_bShowFPSInfo=visible;
+    m_nativeFPSCounter.reset();
+    m_oFPS.SetColour(0xffffffff);
+    m_oFPS.SetText(L"FPS: --");
+    if(visible)m_oFPS.Show();else m_oFPS.Hide();
+}
+void AGUI2::UpdateNativeFPS() {
+    if(!m_bShowFPSInfo)return;
+    const auto frequency=SDL_GetPerformanceFrequency();
+    if(!frequency)return;
+    if(m_nativeFPSCounter.frame(double(SDL_GetPerformanceCounter())/double(frequency))) {
+        const double fps=m_nativeFPSCounter.fps();
+        TStringManager::String16Format(m_wszFPS,TARRAYSIZE(m_wszFPS),L"FPS: %0.1f",fps);
+        m_oFPS.SetText(m_wszFPS);
+        m_oFPS.SetColour(fps<15.0?0xffff0000:(fps<20.0?0xffffff00:0xffffffff));
+    } else if(!m_nativeFPSCounter.hasSample()) {
+        m_oFPS.SetColour(0xffffffff);
+        m_oFPS.SetText(L"FPS: --");
+    }
+}
+#endif
