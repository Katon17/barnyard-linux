+#ifdef TOSHI_SKU_LINUX
+void AFrontEndMainMenuState2::FitNativeMenu() {
+    TFLOAT width,height,rootWidth,rootHeight;
+    m_oMenu.GetDimensions(width,height);
+    AGUI2::GetRootElement()->GetDimensions(rootWidth,rootHeight);
+    TFLOAT scale=TMath::Min(1.0f,TMath::Min((rootHeight-112.0f)/TMath::Max(height,1.0f),(rootWidth-64.0f)/TMath::Max(width,1.0f)));
+    m_oMenu.SetTransform(0.0f,30.0f);
+    m_oMenu.GetTransform().SetScale(scale,scale);
+}
+#endif
