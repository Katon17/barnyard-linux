@@ -93,6 +97,27 @@ void TGLAdapter::EnumerateOutputs( TRenderInterface* a_pRenderer )
 		if ( oMode.dmBitsPerPel == 32 )
 			fnAddMode( oMode.dmPelsWidth, oMode.dmPelsHeight, oMode.dmDisplayFrequency );
 	}
+#elif defined(TOSHI_SKU_LINUX)
+	SDL_DisplayMode desktop{};
+	if (SDL_GetDesktopDisplayMode(0, &desktop) != 0) {
+		TERROR("SDL cannot query desktop display mode: %s\n", SDL_GetError());
+		return;
+	}
+	m_Mode.Set(this, 0, desktop.w, desktop.h, desktop.refresh_rate > 0 ? desktop.refresh_rate : 60);
+	std::set<std::tuple<int, int, int>> seen;
+	auto addUnique = [&](int w, int h, int hz) {
+		if (w > 0 && h > 0 && seen.emplace(w, h, hz).second) fnAddMode(w, h, hz);
+	};
+	for (int i = 0; i < SDL_GetNumDisplayModes(0); ++i) {
+		SDL_DisplayMode mode{};
+		if (SDL_GetDisplayMode(0, i, &mode) == 0)
+			addUnique(mode.w, mode.h, mode.refresh_rate > 0 ? mode.refresh_rate : 60);
+	}
+	// Windowed resolutions need not be physical monitor modes.
+	addUnique(desktop.w, desktop.h, desktop.refresh_rate > 0 ? desktop.refresh_rate : 60);
+	addUnique(1280, 720, 60);
+	addUnique(800, 600, 60);
+	addUnique(640, 480, 60);
 #else
